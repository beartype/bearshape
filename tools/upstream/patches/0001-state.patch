+"""Opt-in stateful hints compose without changing ordinary union checks."""
+
+import pytest
+
+
+def _run_check(check, getters):
+    from beartype.plug._plugstate import _HintCheckState
+
+    with _HintCheckState(getters) as state:
+        state.begin()
+        if check(state):
+            return state.commit()
+        return False
+
+
+@pytest.fixture
+def stateful_hints():
+    bindings = {}
+    snapshots = []
+
+    class State:
+        def snapshot(self):
+            before = bindings.copy()
+            snapshots.append(before)
+            return before
+
+        def restore(self, before):
+            bindings.clear()
+            bindings.update(before)
+
+    state = State()
+
+    def get_state():
+        return state
+
+    def hint(name, *, reject=False, raises=None):
+        class Meta(type):
+            __beartype_state__ = staticmethod(get_state)
+
+            def __instancecheck__(cls, value):
+                if not isinstance(value, list):
+                    return False
+                previous = bindings.setdefault(name, len(value))
+                if raises is not None:
+                    raise raises
+                return previous == len(value) and not reject
+
+            def __instancecheck_str__(cls, value):
+                return f'{name} expected {bindings.get(name)} but got {len(value)}'
+
+        return Meta(f'{name}_{id(bindings)}', (), {})
+
+    return bindings, snapshots, hint
+
+
+def test_composite_union_rollback(stateful_hints):
+    from beartype import beartype
+    from beartype.roar import BeartypeCallHintParamViolation
+
+    bindings, snapshots, hint = stateful_hints
+    N, C = hint('N'), hint('C')
+
+    @beartype
+    def choose(pair: tuple[N, str] | tuple[C, int], last: N):
+        pass
+
+    choose(([1, 2], 1), [1, 2, 3])
+    assert bindings == {'C': 2, 'N': 3}
+    # Two alternatives and the last parameter each need one checkpoint;
+    # the top-level union needs no duplicate snapshot around its alternatives.
+    assert len(snapshots) == 3
+    with pytest.raises(BeartypeCallHintParamViolation):
+        choose(([1, 2], 1), [1, 2, 3, 4])
+    assert bindings == {'C': 2, 'N': 3}
+
+
+def test_plain_class_union_rollback(stateful_hints):
