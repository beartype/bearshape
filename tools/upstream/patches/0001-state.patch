+    a = SimpleNamespace(snapshot=lambda: None, restore=lambda token: restored.append(True))
+    b = SimpleNamespace(snapshot=fail, restore=lambda token: None)
+    with pytest.raises(RuntimeError, match='snapshot failed'):
