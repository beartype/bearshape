+def test_copied_context_does_not_retain_finished_state():
+    from beartype.door import is_bearable
+    from contextvars import copy_context
+    import gc
+    import weakref
+
+    captured = []
+    holder = []
+
+    class State:
+        def snapshot(self):
+            return None
+
+        def restore(self, token):
+            pass
+
+    def get_state():
+        return holder[-1]
+
+    class Meta(type):
+        __beartype_state__ = staticmethod(get_state)
+
+        def __instancecheck__(cls, obj):
+            if not isinstance(obj, list):
+                return False
+            captured.append(copy_context())
+            return True
+
+    class A(metaclass=Meta):
+        pass
+
+    state = State()
+    ref = weakref.ref(state)
+    holder.append(state)
+    assert is_bearable([], A)
+    holder.clear()
+    del state
+    gc.collect()
+    assert captured
+    assert ref() is None
