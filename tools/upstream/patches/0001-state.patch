+def test_nested_union_bindings_match_independent_reference(stateful_hints):
+    from beartype.door import is_bearable
+    from random import Random
+    from types import UnionType
+    from typing import get_args, get_origin
+
+    bindings, _, hint = stateful_hints
+    N, C = hint('N'), hint('C')
+    inner = tuple[N, str] | tuple[C, int]
+    hints = (
+        inner, tuple[inner, N], tuple[N, inner],
+        tuple[inner, str] | tuple[tuple[N, int], int],
+    )
+    random = Random(9231)
+
+    def value(depth):
+        if depth and random.randrange(2):
+            return value(depth - 1), value(depth - 1)
+        return random.choice((0, 's', None, [], [1], [1, 2]))
+
+    def reference(obj, annotation, state):
+        before = state.copy()
+        origin = get_origin(annotation)
+        if origin is UnionType:
+            valid = any(reference(obj, child, state) for child in get_args(annotation))
+        elif origin is tuple:
+            children = get_args(annotation)
+            valid = isinstance(obj, tuple) and len(obj) == len(children) and all(
+                reference(item, child, state) for item, child in zip(obj, children))
+        elif annotation in (N, C):
+            name = 'N' if annotation is N else 'C'
+            valid = isinstance(obj, list) and state.setdefault(name, len(obj)) == len(obj)
+        else:
+            valid = isinstance(obj, annotation)
+        if not valid:
+            state.clear()
+            state.update(before)
+        return valid
+
+    for annotation in hints:
+        for _ in range(150):
+            obj = value(3)
+            initial = {'earlier': 9}
+            if random.randrange(2):
+                initial['N'] = random.randrange(3)
+            bindings.clear()
+            bindings.update(initial)
+            expected = initial.copy()
+            result = reference(obj, annotation, expected)
+            assert is_bearable(obj, annotation) is result
+            assert bindings == expected
+
