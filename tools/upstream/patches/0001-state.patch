+#!/usr/bin/env python3
+# --------------------( LICENSE                            )--------------------
+# Copyright (c) 2014-2026 Beartype authors.
+# See "LICENSE" for further details.
+
+"""Invocation-owned transactions for opt-in stateful runtime hints."""
+
+from beartype._data.typing.datatyping import Pep3119Checkable
+from collections.abc import Callable
+from contextlib import ExitStack
+from contextvars import ContextVar, Token
+from typing import Any, Protocol
+
+
+class HintState(Protocol):
+    """A library-owned state domain; snapshot tokens are opaque to beartype."""
+
+    def snapshot(self) -> Any: ...
+    def restore(self, snapshot: Any) -> None: ...
+
+
+StateGetter = Callable[[], HintState]
+Rollback = tuple[Callable[[Any], None], Any]
+
+
+class _HintCheckState:
+    """Nested checkpoints sharing state located once per checking expression."""
+
+    __slots__ = ('getters', 'states', 'transactions', '_token')
+
+    def __init__(self, getters: tuple[StateGetter, ...]) -> None:
+        self.getters = getters
+        states = []
+        for getter in getters:
+            state = getter()
+            _validate_state(state)
+            states.append(state)
+        self.states = tuple(states)
+        self.transactions: list[list[Rollback]] = []
+        self._token: Token[tuple['_HintCheckState', ...]] | None = None
+
+    def __enter__(self) -> '_HintCheckState':
+        parents = _ACTIVE_CHECK_STATES.get()
+        if parents:
+            parents = tuple(parent for parent in parents if parent._token is not None)
+        # Resolved aliases enrol their domains before mutating shared state.
+        for parent in parents:
+            parent.register(self.getters, self.states)
+        self._token = _ACTIVE_CHECK_STATES.set((*parents, self))
+        return self
+
+    def __exit__(self, *exception: object) -> None:
+        try:
+            if self.transactions:
+                self.close()
+        finally:
+            assert self._token is not None
+            token = self._token
+            self._token = None
+            # copy_context() can outlive this check. Do not let a copied
+            # context retain invocation state or enrol into a finished check.
+            self.getters = ()
+            self.states = ()
+            _ACTIVE_CHECK_STATES.reset(token)
+
+    def register(
+        self, getters: tuple[StateGetter, ...], states: tuple[HintState, ...] = (),
+    ) -> None:
+        for index, getter in enumerate(getters):
+            if not any(getter is known for known in self.getters):
+                state = states[index] if states else getter()
+                _validate_state(state)
+                self.getters += (getter,)
+                self.states += (state,)
+                for transaction in self.transactions:
+                    transaction.append((state.restore, state.snapshot()))
+
+    def begin(self) -> bool:
+        transaction: list[Rollback] = []
+        self.transactions.append(transaction)
+        for state in self.states:
+            transaction.append((state.restore, state.snapshot()))
+        return True
+
+    def commit(self) -> bool:
+        self.transactions.pop()
+        return True
+
+    def rollback(self) -> bool:
+        _restore(self.transactions.pop())
+        return False
+
+    def close(self) -> None:
+        callbacks = [restore for transaction in self.transactions for restore in transaction]
+        self.transactions.clear()
+        _restore(callbacks)
+
+
+def _validate_state(state: HintState) -> None:
+    if not callable(getattr(state, 'snapshot', None)) or not callable(getattr(state, 'restore', None)):
+        raise TypeError(
+            '__beartype_state__() must return an object with callable '
+            'snapshot and restore methods.')
+
+
+def _restore(callbacks: list[Rollback]) -> None:
+    while callbacks:
+        restore, snapshot = callbacks.pop()
+        try:
+            restore(snapshot)
+        except BaseException:
+            # Keep general context-manager machinery off the successful path,
+            # but still unwind every domain when a broken plugin raises.
+            with ExitStack() as pending:
+                for restore, snapshot in callbacks:
+                    pending.callback(restore, snapshot)
+                callbacks.clear()
+            raise
+
+
+_ACTIVE_CHECK_STATES: ContextVar[tuple[_HintCheckState, ...]] = ContextVar(
+    'beartype_check_states', default=())
+
+
+def isinstance_stateful(obj: object, hint: Pep3119Checkable, getter: StateGetter) -> bool:
+    """Check a resolved root reference without another generated wrapper."""
+    parents = _ACTIVE_CHECK_STATES.get()
+    if parents:
+        parents = tuple(parent for parent in parents if parent._token is not None)
+    if parents:
+        for parent in parents:
+            parent.register((getter,))
+        return isinstance(obj, hint)
+    with _HintCheckState((getter,)) as state:
+        state.begin()
+        if isinstance(obj, hint):
+            return state.commit()
+        return False
