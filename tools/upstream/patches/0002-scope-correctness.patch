+            hint, conf, 'is_bearable() ', _make_code_delegated_check))
+    return checker(obj)
diff --git a/beartype_test/a00_unit/a40_api/plug/test_plugscope.py b/beartype_test/a00_unit/a40_api/plug/test_plugscope.py
