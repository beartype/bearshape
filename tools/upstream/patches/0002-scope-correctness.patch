+"""Public scope identity, named arguments and release of user values."""
+import gc
+import weakref
+from contextvars import copy_context
+from typing import Annotated
+
+import pytest
+from beartype import beartype, BeartypeConf
+from beartype.door import is_bearable, die_if_unbearable
+from beartype.plug import get_hint_check_scope
+from beartype.vale import Is
+
+
+def test_no_scope_outside_check():
+    assert get_hint_check_scope() is None
+
+
+def test_arguments_defaults_return_and_invocation_identity():
+    scopes = []
+
+    def capture(value):
+        scope = get_hint_check_scope()
+        assert scope is get_hint_check_scope()
+        scopes.append(scope)
+        return True
+
+    hint = Annotated[int, Is[capture]]
+
+    @beartype
+    def checked(x: hint, /, width=3, *, height=4) -> hint:
+        return x
+
+    assert checked(2, height=5) == 2
+    assert scopes[0] is scopes[1]
+    assert scopes[0].arguments == {'x': 2, 'width': 3, 'height': 5}
+    checked(7)
+    assert scopes[2] is not scopes[0]
+    assert scopes[2].owner_code is checked.__code__
+    assert scopes[2].state == {}
+    assert get_hint_check_scope() is None
+
+
+@pytest.mark.parametrize('public_first', [True, False])
+def test_delegation_and_public_checker_cache_are_distinct(public_first):
+    from beartype.plug._plugstate import is_bearable_delegated
+    captures = []
+
+    def capture(value):
+        captures.append(get_hint_check_scope())
+        return True
+
+    hint = Annotated[int, Is[capture]]
+    conf = BeartypeConf()
+
+    def parent(value):
+        scope = get_hint_check_scope()
+        operations = (
+            lambda: is_bearable(1, hint, conf=conf),
+            lambda: is_bearable_delegated(1, hint, conf=conf))
+        if not public_first:
+            operations = operations[::-1]
+        for operation in operations:
+            assert operation()
+        public_scope, delegated_scope = captures if public_first else captures[::-1]
+        assert delegated_scope is scope
+        assert public_scope is not scope
+        assert public_scope.arguments == {}
+        return True
+
+    assert is_bearable(1, Annotated[int, Is[parent]])
+
+
+def test_nested_decorated_and_door_raiser_scopes_are_independent():
+    captures = []
+
+    def capture(value):
+        captures.append(get_hint_check_scope())
+        return True
+
+    hint = Annotated[int, Is[capture]]
+
+    @beartype
+    def inner(x: hint):
+        pass
+
+    def parent(value):
+        outer = get_hint_check_scope()
+        inner(value)
+        die_if_unbearable(value, hint)
+        assert len(captures) == 2
+        assert all(scope is not outer for scope in captures)
+        assert captures[0] is not captures[1]
+        return True
+
+    assert is_bearable(1, Annotated[int, Is[parent]])
+
+
+@pytest.mark.parametrize('reject', [False, True])
+def test_completed_scope_does_not_retain_argument_or_leak_through_context(reject):
+    contexts = []
+
+    def capture(value):
+        scope = get_hint_check_scope()
+        scope.state[object()] = value
+        contexts.append(copy_context())
+        return not reject
+
+    class Value:
+        pass
+
+    value = Value()
+    ref = weakref.ref(value)
+    assert is_bearable(value, Annotated[Value, Is[capture]]) is not reject
+    del value
+    gc.collect()
+    assert ref() is None
+    assert contexts[0].run(get_hint_check_scope) is None
