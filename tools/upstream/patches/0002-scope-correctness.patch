+#!/usr/bin/env python3
+# --------------------( LICENSE                            )--------------------
+# Copyright (c) 2014-2026 Beartype authors.
+# See "LICENSE" for further details.
+
+"""Lazy invocation scopes for cooperating stateful hint plugins."""
+
+from collections.abc import Callable
+from inspect import signature
+from sys import _getframe
+from types import CodeType, FrameType
+from typing import Any
+
+
+class HintCheckScope:
+    """State and arguments owned by one checking invocation.
+
+    ``state`` is a mutable namespace for plugins; use a private object as a key.
+    ``owner_code`` identifies the generated entry point, not an invocation.
+    ``arguments`` lazily binds the original callable's named arguments, including
+    defaults. Standalone DOOR checks have no named function arguments.
+
+    Instances retain neither a frame nor a ContextVar token. Do not retain this
+    object beyond a check: its state and arguments may contain user objects.
+    """
+
+    __slots__ = ('state', 'owner_code', '_func', '_args', '_kwargs', '_arguments')
+
+    def __init__(
+        self, owner_code: CodeType, func: Callable[..., Any] | None,
+        args: tuple[Any, ...], kwargs: dict[str, Any],
+    ) -> None:
+        self.state: dict[object, object] = {}
+        self.owner_code = owner_code
+        self._func = func
+        self._args = args
+        self._kwargs = kwargs
+        self._arguments: dict[str, Any] | None = None
+
+    @property
+    def arguments(self) -> dict[str, Any]:
+        """Named arguments for this invocation, materialized on first access."""
+        if self._arguments is None:
+            if self._func is None:
+                self._arguments = {}
+            else:
+                bound = signature(self._func).bind_partial(*self._args, **self._kwargs)
+                bound.apply_defaults()
+                self._arguments = dict(bound.arguments)
+        return self._arguments
+
+
+def get_hint_check_scope() -> HintCheckScope | None:
+    """Return the nearest public check scope, or None outside a check.
+
+    Parameters and return checks share their decorated invocation. Public DOOR
+    calls and nested decorated calls start independent scopes. Internal alias
+    delegation shares the caller's scope. Scopes are allocated only on demand;
+    ordinary beartype checks never allocate a public scope.
+    """
+    frame = _get_hint_check_frame()
+    try:
+        if frame is None:
+            return None
+        values = frame.f_locals
+        scope = values.get('__beartype_scope_instance__')
+        if scope is None:
+            scope = HintCheckScope(
+                frame.f_code, values.get('__beartype_func'),
+                values.get('args', ()), values.get('kwargs', {}))
+            values['__beartype_scope_instance__'] = scope
+        return scope
+    finally:
+        del frame
+
+
+def _get_hint_check_owner_id() -> int | None:
+    """Identify a live invocation without retaining its frame or allocating state."""
+    frame = _get_hint_check_frame()
+    try:
+        return id(frame) if frame is not None else None
+    finally:
+        del frame
+
+
+def _get_hint_check_frame() -> FrameType | None:
+    """Find the public boundary; callers must release the returned frame."""
+    frame = _getframe(1)
+    try:
+        while frame is not None:
+            # The producer owns this marker. Plugins never inspect generated
+            # names, bytecode or undocumented locals to decide delegation.
+            if '__beartype_scope_boundary__' in frame.f_code.co_varnames:
+                values = frame.f_locals
+                if values.get('__beartype_scope_boundary__') is True:
+                    return frame
+            frame = frame.f_back
+        return None
+    finally:
+        del frame
