+"""Transaction domains belong to one live public checking invocation."""
+
+import gc
+import sys
+import weakref
+from contextvars import copy_context
+from typing import Annotated
+
+import pytest
+from beartype import beartype
+from beartype.door import die_if_unbearable, is_bearable
+from beartype.plug import get_hint_check_scope
+from beartype.roar import BeartypeCallHintParamViolation, BeartypeDoorHintViolation
+from beartype.vale import Is
+from beartype._check.forward.reference._cls.fwdrefcache import ref_proxy_cache
+
+
+@pytest.fixture
+def isolated_domains(monkeypatch, request):
+    ref_proxy_cache.clear_cache()
+    key = object()
+    states = []
+
+    class State:
+        def __init__(self):
+            self.bindings = {}
+
+        def snapshot(self):
+            return self.bindings.copy()
+
+        def restore(self, before):
+            self.bindings.clear()
+            self.bindings.update(before)
+
+    def get_state():
+        scope = get_hint_check_scope()
+        assert scope is not None
+        if key not in scope.state:
+            state = State()
+            states.append(state)
+            scope.state[key] = state
+        return scope.state[key]
+
+    class Meta(type):
+        __beartype_state__ = staticmethod(get_state)
+
+        def __instancecheck__(cls, value):
+            if not isinstance(value, list):
+                return False
+            state = get_state()
+            return state.bindings.setdefault(cls.__name__, len(value)) == len(value)
+
+    N, C = Meta('N', (), {}), Meta('C', (), {})
+    for hint in (N, C):
+        hint.__qualname__ = f'{request.node.name}.{hint.__name__}'
+
+    def resolve():
+        monkeypatch.setattr(sys.modules[__name__], 'IsolationLaterN', N, raising=False)
+        monkeypatch.setattr(sys.modules[__name__], 'IsolationLaterC', C, raising=False)
+
+    yield N, C, get_state, states, resolve
+    ref_proxy_cache.clear_cache()
+
+
+@pytest.mark.parametrize('kind', ['door', 'raiser', 'decorated'])
+@pytest.mark.parametrize('nested_first', [True, False])
+@pytest.mark.parametrize('nested_rejects', [True, False])
+def test_independent_nested_domain_never_enrolls_in_outer(
+    isolated_domains, kind, nested_first, nested_rejects):
+    N, _, _, states, resolve = isolated_domains
+    inner_states = []
+    inner_hint = tuple[N, str if nested_rejects else int]
+
+    @beartype
+    def inner(value: inner_hint):
+        pass
+
+    def independent(value):
+        start = len(states)
+        item = ([0] * 7, 1)
+        if kind == 'door':
+            assert is_bearable(item, inner_hint) is not nested_rejects
+        elif nested_rejects:
+            exception = (BeartypeDoorHintViolation if kind == 'raiser'
+                         else BeartypeCallHintParamViolation)
+            with pytest.raises(exception):
+                die_if_unbearable(item, inner_hint) if kind == 'raiser' else inner(item)
+        elif kind == 'raiser':
+            die_if_unbearable(item, inner_hint)
+        else:
+            inner(item)
+        inner_states.extend(states[start:])
+        return True
+
+    # Beartype caches composite hints by repr; give each closure its own name.
+    independent.__qualname__ += f'_{kind}_{nested_first}_{nested_rejects}'
+    probe = Annotated[int, Is[independent]]
+    hint = (
+        tuple[probe, 'IsolationLaterN', str] | tuple[int, 'IsolationLaterC', int]
+        if nested_first else
+        tuple['IsolationLaterN', probe, str] | tuple['IsolationLaterC', int, int])
+
+    @beartype
+    def outer(value: hint, last: N):
+        pass
+
+    resolve()
+    value = (1, [0, 0], 1) if nested_first else ([0, 0], 1, 1)
+    outer(value, [0, 0, 0])
+    assert inner_states
+    assert all(state.bindings == ({} if nested_rejects else {'N': 7})
+               for state in inner_states)
+    # A successful first alternative must still constrain later arguments.
+    first = (*value[:2], 'accepted')
+    with pytest.raises(BeartypeCallHintParamViolation):
+        outer(first, [0, 0, 0])
+    outer(first, [0, 0])
+
+
+def test_recursive_invocations_of_same_wrapper_have_different_owners(isolated_domains):
+    N, _, get_state, _, resolve = isolated_domains
+    depth = 0
+    completed = []
+
+    def recurse(value):
+        nonlocal depth
+        if not depth:
+            depth += 1
+            try:
+                outer((0, [0] * 7, 'accepted'), [0] * 7)
+            finally:
+                depth -= 1
+        return True
+
+    probe = Annotated[int, Is[recurse]]
+
+    @beartype
+    def outer(value: tuple[probe, 'IsolationLaterN', str]
+              | tuple[int, 'IsolationLaterC', int], last: N):
+        completed.append(get_state())
+
+    resolve()
+    outer((1, [0, 0], 1), [0, 0, 0])
+    assert completed[0].bindings == {'N': 7}
+    assert completed[1].bindings == {'C': 2, 'N': 3}
+
+
+def test_copied_active_context_does_not_join_another_thread(isolated_domains):
+    from concurrent.futures import ThreadPoolExecutor
+
+    N, _, _, states, resolve = isolated_domains
+    inner_states = []
+
+    def independent(value):
+        start = len(states)
+        with ThreadPoolExecutor(max_workers=1) as executor:
+            assert executor.submit(copy_context().run, is_bearable,
+                                   ([0] * 7, 1), tuple[N, int]).result()
+        inner_states.extend(states[start:])
+        return True
+
+    probe = Annotated[int, Is[independent]]
+
+    @beartype
+    def outer(value: tuple[probe, 'IsolationLaterN', str]
+              | tuple[int, 'IsolationLaterC', int], last: N):
+        pass
+
+    resolve()
+    outer((1, [0, 0], 1), [0, 0, 0])
+    assert all(state.bindings == {'N': 7} for state in inner_states)
+
+
+def test_transaction_ownership_does_not_allocate_public_scopes(monkeypatch):
+    from beartype.plug import _plugscope
+
+    ref_proxy_cache.clear_cache()
+
+    def unexpected(*args, **kwargs):
+        raise AssertionError('Ordinary checking allocated a public scope')
+
+    monkeypatch.setattr(_plugscope, 'HintCheckScope', unexpected)
+
+    @beartype
+    def checked(value: tuple['IsolationPlainClass', int]):
+        pass
+
+    class Plain:
+        pass
+
+    monkeypatch.setattr(sys.modules[__name__], 'IsolationPlainClass', Plain, raising=False)
+    checked((Plain(), 1))
+    checked((Plain(), 2))
+    ref_proxy_cache.clear_cache()
+
+
+@pytest.mark.parametrize('reject', [False, True])
+def test_finished_transaction_releases_owner_arguments(isolated_domains, reject):
+    _, _, _, states, resolve = isolated_domains
+    contexts = []
+
+    def capture(value):
+        contexts.append(copy_context())
+        return not reject
+
+    capture.__qualname__ += f'_{reject}'
+    probe = Annotated[object, Is[capture]]
+
+    @beartype
+    def checked(value: tuple[probe, 'IsolationLaterN', str]):
+        pass
+
+    class Value:
+        pass
+
+    resolve()
+    value = Value()
+    reference = weakref.ref(value)
+    if reject:
+        with pytest.raises(BeartypeCallHintParamViolation):
+            checked((value, [0], 'accepted'))
+    else:
+        checked((value, [0], 'accepted'))
+    del value
+    states.clear()
+    gc.collect()
+    assert reference() is None
+    assert contexts[0].run(get_hint_check_scope) is None
diff --git a/doc/src/api_plug.rst b/doc/src/api_plug.rst
index 7ca24330..c27343af 100644
--- a/doc/src/api_plug.rst
+++ b/doc/src/api_plug.rst
@@ -99,3 +99,28 @@ needed if a plugin's restore method itself raises.
 
 Python's bare ``isinstance`` does not invoke this protocol. Libraries should
 preserve any individual-check guarantees they need outside beartype.
+
+Invocation scopes
+-----------------
+
+``beartype.plug.get_hint_check_scope()`` returns a ``HintCheckScope`` for the
+nearest generated public check, or ``None`` outside checking. Scope creation
+is lazy: checks that never request state allocate no scope object. Parameters
+and returns share the decorated invocation. Nested decorated calls and public
+DOOR calls start separate scopes, while an internally delegated forward alias
+shares the enclosing scope. Checker caches preserve that distinction regardless
+of which path is used first.
+
+Use ``scope.state`` as a library namespace keyed by a private object, rather
+than a string another plugin might use. ``scope.arguments`` lazily provides
+bound function arguments, including defaults; standalone DOOR scopes provide
+an empty mapping. ``scope.owner_code`` identifies the generated entry point
+for explicit decorator integration; it is not an invocation identifier.
+Scope object identity distinguishes invocations. Scope lookup follows the
+live call stack, so copied execution contexts cannot resurrect completed scopes.
+
+Do not retain a scope past the check: its state and arguments may retain user
+objects. Scope objects themselves hold no frames or context tokens. Scope
+ownership does not replace state rollback: a rejected composite alternative
+must restore registered domains, and a rejected nested leaf must roll back even
+when a predicate catches the rejection and then succeeds.
