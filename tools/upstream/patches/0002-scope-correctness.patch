+def is_bearable_delegated(obj, hint, *, conf) -> bool:
+    """Check an internal subhint without creating a public checking scope."""
+    global _delegate_tester_factory
+    if _delegate_tester_factory is None:
+        from beartype._check.make.checkmakecls import BeartypeFuncCheckerFactoryCache
+        _delegate_tester_factory = BeartypeFuncCheckerFactoryCache()
