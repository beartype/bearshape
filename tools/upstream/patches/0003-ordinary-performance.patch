+class _PlainForwardCheck:
+    """Specialize resolved ordinary references without resolving unused hints.
+
+    Fast functions capture plain classes, not proxies: a cache clear racing an
+    in-flight check cannot switch that check to a new stateful referent. Clearing
+    the reference cache drops fast functions and captured classes immediately.
+    """
+
+    __slots__ = (
+        '_slow', '_parameters', '_expression', '_globals', '_refs', '_cache',
+        '_fast', '_revision', '__weakref__')
+
+    def __init__(self, slow, parameters, expression, scope):
+        from beartype._check.forward.reference._cls.fwdrefcache import ref_proxy_cache
+        from beartype._check.forward.reference.fwdreftest import is_beartype_ref_proxy
+        self._slow = slow
+        self._parameters = parameters
+        self._expression = expression
+        self._globals = scope
+        self._refs = {name: value for name, value in scope.items()
+                      if is_beartype_ref_proxy(value)}
+        self._cache = ref_proxy_cache
+        self._fast = None
+        self._revision = -1
+        with self._cache._lock:
+            self._cache._state_checkers.add(self)
+
+    def invalidate(self):
+        self._fast = None
+        self._revision = -1
+
+    def __call__(self, *args):
+        fast = self._fast
+        if fast is not None:
+            return fast(*args)
+        result = self._slow(*args)
+        if self._revision != self._cache._state_revision:
+            self._specialize()
+        return result
+
+    def _specialize(self):
+        from inspect import getattr_static
+        from beartype._data.kind.datakindiota import SENTINEL
+        from beartype._util.func.utilfuncmake import make_func
+        from beartype._util.hint.pep.utilpeptest import is_hint_pep
+        with self._cache._lock:
+            self._revision = self._cache._state_revision
+            scope = dict(self._globals)
+            for name, proxy in self._refs.items():
+                hint = self._cache._ref_proxy_to_resolved_hint_get(proxy, SENTINEL)
+                # Exclude custom metaclasses, unknown/composite hints and state
+                # hooks. No resolution and no user predicate runs here.
+                if (type(hint) is not type or is_hint_pep(hint) or
+                    getattr_static(hint, '__beartype_state__', None) is not None):
+                    return
+                scope[name] = hint
+            self._fast = make_func(
+                func_name='__beartype_plain_forward',
+                func_code=(f'def __beartype_plain_forward({self._parameters}):\n'
+                           f'    return {self._expression}\n'),
+                func_globals=scope)
diff --git a/beartype_test/a00_unit/a40_api/plug/test_plugstate_fast.py b/beartype_test/a00_unit/a40_api/plug/test_plugstate_fast.py
