index 00000000..0cf4aed6
--- /dev/null
+++ b/beartype_test/a00_unit/a40_api/plug/test_plugstate_fast.py
@@ -0,0 +1,243 @@
+"""Optimization preserves lazy resolution, sampling and cache invalidation."""
+import gc
+import weakref
+from concurrent.futures import ThreadPoolExecutor
+from typing import Annotated
+
+import pytest
+from beartype import beartype
+from beartype.door import is_bearable
+from beartype.roar import BeartypeCallHintParamViolation
+from beartype.vale import Is
+from beartype._check.forward.reference._cls.fwdrefcache import ref_proxy_cache
+from beartype.plug._plugstate import _PlainForwardCheck
+
+
+@beartype
+def plain_tuple(value: tuple['LatePlain', int]):
+    pass
+
+
+@beartype
+def plain_mapping(value: dict[str, 'LatePlain']):
+    pass
+
+
+@beartype
+def plain_nested_list(value: list[list['LatePlain']]):
+    pass
+
+
+class LatePlain:
+    pass
+
+
+def dispatcher(func):
+    return next(value for value in func.__kwdefaults__.values()
+                if isinstance(value, _PlainForwardCheck))
+
+
+@pytest.mark.parametrize('func,wrap', [
+    (plain_tuple, lambda value: (value, 1)),
+    (plain_mapping, lambda value: {'key': value}),
+    (plain_nested_list, lambda value: [[value]]),
+])
+def test_plain_references_specialize_only_after_check(func, wrap):
+    ref_proxy_cache.clear_cache()
+    state = dispatcher(func)
+    assert state._fast is None
+    func(wrap(LatePlain()))
+    assert state._fast is not None
+    func(wrap(LatePlain()))
+    with pytest.raises(BeartypeCallHintParamViolation):
+        func(wrap(object()))
+
+
+def test_unselected_reference_remains_unresolved():
+    @beartype
+    def optional(value: tuple['NeverDefinedForFastPath', int] | str):
+        pass
+
+    for _ in range(3):
+        optional('selected stateless alternative')
+    state = dispatcher(optional)
+    assert state._fast is None
+    from beartype._data.kind.datakindiota import SENTINEL
+    assert all(ref_proxy_cache.get_ref_proxy_referent_hint_if_resolved_or_sentinel(proxy)
+               is SENTINEL for proxy in state._refs.values())
+
+
+def test_clear_invalidates_plain_to_stateful_and_back(monkeypatch):
+    bindings = {}
+
+    class State:
+        def snapshot(self):
+            return bindings.copy()
+
+        def restore(self, saved):
+            bindings.clear()
+            bindings.update(saved)
+
+    state = State()
+
+    class Meta(type):
+        __beartype_state__ = staticmethod(lambda: state)
+
+        def __instancecheck__(cls, value):
+            if value is None:
+                return False
+            bindings['seen'] = True
+            return True
+
+    class Stateful(metaclass=Meta):
+        pass
+
+    ref_proxy_cache.clear_cache()
+    plain_tuple((LatePlain(), 1))
+    fast_ref = weakref.ref(dispatcher(plain_tuple)._fast)
+    old = LatePlain
+    monkeypatch.setitem(globals(), 'LatePlain', Stateful)
+    ref_proxy_cache.clear_cache()
+    gc.collect()
+    assert fast_ref() is None
+    with pytest.raises(BeartypeCallHintParamViolation):
+        plain_tuple((object(), None))
+    assert bindings == {}
+    assert dispatcher(plain_tuple)._fast is None
+    monkeypatch.setitem(globals(), 'LatePlain', old)
+    ref_proxy_cache.clear_cache()
+    plain_tuple((old(), 1))
+    assert dispatcher(plain_tuple)._fast is not None
+    ref_proxy_cache.clear_cache()
+
+
+def test_fast_expression_keeps_captured_plain_types_during_clear(monkeypatch):
+    ref_proxy_cache.clear_cache()
+    value = LatePlain()
+    plain_tuple((value, 1))
+    in_flight = dispatcher(plain_tuple)._fast
+    monkeypatch.setitem(globals(), 'LatePlain', type('Replacement', (), {}))
+    ref_proxy_cache.clear_cache()
+    # A caller that already loaded the fast function finishes on its old
+    # snapshot. New calls must use the replacement, not the old specialization.
+    assert in_flight((value, 1))
+    with pytest.raises(BeartypeCallHintParamViolation):
+        plain_tuple((value, 1))
+    plain_tuple((LatePlain(), 1))
+    monkeypatch.undo()
+    ref_proxy_cache.clear_cache()
+
+
+def test_concurrent_cache_clearing():
+    def check(_):
+        for _ in range(40):
+            plain_tuple((LatePlain(), 1))
+            plain_mapping({'a': LatePlain()})
+
+    def clear(_):
+        for _ in range(40):
+            ref_proxy_cache.clear_cache()
+
+    with ThreadPoolExecutor(max_workers=4) as pool:
+        list(pool.map(check, range(3)))
+        futures = [pool.submit(check, 0), pool.submit(clear, 0), pool.submit(check, 0)]
+        for future in futures:
+            future.result()
+
+
+def test_known_domains_do_not_publish_extra_context():
+    from beartype.plug._plugstate import _KnownHintCheckState, _ACTIVE_CHECK_STATES
+    before = _ACTIVE_CHECK_STATES.get()
+    with _KnownHintCheckState(()) as state:
+        assert _ACTIVE_CHECK_STATES.get() is before
+        state.begin()
+        state.commit()
+
+
+def test_atomic_root_omits_only_duplicate_snapshot():
+    snapshots = []
+    bindings = {}
+
+    class State:
+        def snapshot(self):
+            snapshots.append(1)
+            return bindings.copy()
+
+        def restore(self, before):
+            bindings.clear()
+            bindings.update(before)
+
+    state = State()
+
+    class Meta(type):
+        __beartype_state__ = staticmethod(lambda: state)
+        __beartype_state_atomic__ = True
+
+        def __instancecheck__(cls, value):
+            saved = state.snapshot()
+            bindings['seen'] = True
+            if value is None:
+                state.restore(saved)
+                return False
+            return True
+
+    class Atomic(metaclass=Meta):
+        pass
+
+    # Compile first: decoration can probe an instance-checkable metaclass.
+    assert is_bearable(1, Atomic)
+    snapshots.clear()
+    bindings.clear()
+    assert is_bearable(1, Atomic)
+    assert len(snapshots) == 1
+    bindings.clear()
+    assert not is_bearable(None, Atomic)
+    assert bindings == {}
+    assert not is_bearable((1, None), tuple[Atomic, int])
+    assert bindings == {}
+
+
+def test_custom_metaclass_never_specializes(monkeypatch):
+    calls = []
+
+    class Meta(type):
+        def __instancecheck__(cls, value):
+            calls.append(value)
+            return True
+
+    monkeypatch.setitem(globals(), 'LatePlain', Meta('Custom', (), {}))
+    ref_proxy_cache.clear_cache()
+    for _ in range(3):
+        plain_tuple((object(), 1))
+    assert dispatcher(plain_tuple)._fast is None
+    assert len(calls) >= 3
+    monkeypatch.undo()
+    ref_proxy_cache.clear_cache()
+
+
+def test_specialization_preserves_single_sample_and_predicate_calls(monkeypatch):
+    accesses = []
+    predicates = []
+
+    class SampledList(list):
+        def __getitem__(self, index):
+            accesses.append(index)
+            return super().__getitem__(index)
+
+    def predicate(value):
+        predicates.append(1)
+        return True
+
+    @beartype
+    def checked(value: Annotated[tuple['LateForPredicate', int], Is[predicate]]):
+        pass
+
+    monkeypatch.setitem(globals(), 'LateForPredicate', LatePlain)
+    ref_proxy_cache.clear_cache()
+    for iteration in range(3):
+        plain_nested_list(SampledList([SampledList([LatePlain(), LatePlain()])]))
+        checked((LatePlain(), 1))
+        assert len(accesses) == 2 * (iteration + 1)
+        assert len(predicates) == iteration + 1
+    assert dispatcher(plain_nested_list)._fast is not None
+    assert dispatcher(checked)._fast is not None
diff --git a/doc/src/api_plug.rst b/doc/src/api_plug.rst
index c27343af..8eabac9e 100644
--- a/doc/src/api_plug.rst
+++ b/doc/src/api_plug.rst
@@ -124,3 +124,31 @@ objects. Scope objects themselves hold no frames or context tokens. Scope
 ownership does not replace state rollback: a rejected composite alternative
 must restore registered domains, and a rejected nested leaf must roll back even
 when a predicate catches the rejection and then succeeds.
+
+Optional atomic leaves and ordinary references
+---------------------------------------------
+
+A stateful runtime hint may additionally expose
+``__beartype_state_atomic__ = True``. This promises that its own instance check
+restores every mutation on a false result or any exception, including
+``BaseException``. Only a primitive root with this explicit promise omits its
+otherwise redundant outer checkpoint. Composite parents still take snapshots,
+since a later child may reject the entire alternative. Do not declare the
+promise for a validator that only restores ordinary Exception subclasses.
+
+Checks whose domains are all known register them with an active parent but do
+not publish an unnecessary new transaction context. Unknown references still
+receive transactional handling on their first check. An ordinary composite
+reference check may specialize after natural resolution has shown every proxy
+to reference a plain class with the builtin metaclass and no state hook.
+Specialization never resolves an unused branch, repeats a predicate, or changes
+container sampling. Custom metaclasses and composite/stateful aliases remain
+on the general path. State hooks, like other compiled hint metadata, must remain
+stable while the corresponding checker is cached.
+
+Reference-cache clearing discards specialized functions and their captured
+classes. An in-flight call that already loaded a fast function finishes using
+its captured old class snapshot; subsequent calls re-resolve. This preserves
+cache invalidation without a lock around every ordinary check. Root references
+and single sampled-reference lists retain native proxy checking; the proposal
+still adds a small state-hook lookup cost to those paths.
